---
import { Icon } from "astro-icon/components";
import { navBarConfig, siteConfig } from "../config";
import {
	flattenNavBarItems,
	isNavBarGroup,
	navLabel,
	resolveNavBarItems,
} from "../utils/nav-utils";
import { url } from "../utils/url-utils";
import LightDarkSwitch from "./LightDarkSwitch.svelte";
import Search from "./Search.svelte";
import DisplaySettings from "./widget/DisplaySettings.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

const className = Astro.props.class;

const items = resolveNavBarItems(navBarConfig.links);
// The mobile panel stays a flat list: every grouped link must remain reachable there.
const links = flattenNavBarItems(items);
---
<div id="navbar" class="z-50 onload-animation">
    <div class="absolute h-8 left-0 right-0 -top-8 bg-[var(--card-bg)] transition"></div> <!-- used for onload animation -->
    <div class:list={[
        className,
        "card-base !overflow-visible max-w-[var(--page-width)] h-[4.5rem] !rounded-t-none mx-auto flex items-center justify-between px-4"]}>
        <a href={url('/')} class="btn-plain scale-animation rounded-lg h-[3.25rem] px-5 font-bold active:scale-95">
            <div class="flex flex-row text-[var(--primary)] items-center text-md">
                <Icon name="material-symbols:home-outline-rounded" class="text-[1.75rem] mb-1 mr-2" />
                {siteConfig.title}
            </div>
        </a>
        <div class="hidden md:flex">
            {items.map((item, index) => {
                if (isNavBarGroup(item)) {
                    const panelId = `nav-group-panel-${index}`;
                    return <div class="relative" data-nav-group>
                        <button type="button" aria-haspopup="true" aria-expanded="false" aria-controls={panelId}
                                data-nav-group-trigger
                                class="btn-plain scale-animation rounded-lg h-11 font-bold px-3 lg:px-4 xl:px-5 active:scale-95"
                        >
                            <div class="flex items-center">
                                {navLabel(item)}
                                <Icon name="material-symbols:keyboard-arrow-down-rounded" class="text-[1.25rem] transition -translate-y-[1px] ml-1 text-black/[0.2] dark:text-white/[0.2]"></Icon>
                            </div>
                        </button>
                        <div id={panelId} data-nav-group-panel
                             class="float-panel float-panel-closed absolute top-full right-0 transition-all min-w-[9rem] py-1 px-1"
                        >
                            {item.children.map((child) => {
                                return <a aria-label={navLabel(child)} href={child.external ? child.url : url(child.url)}
                                          target={child.external ? "_blank" : null}
                                          class="group flex items-center justify-between gap-4 rounded-lg px-3 py-2 font-bold whitespace-nowrap
                                                 text-black/75 dark:text-white/75 transition
                                                 hover:bg-[var(--btn-plain-bg-hover)] hover:text-[var(--primary)]
                                                 active:bg-[var(--btn-plain-bg-active)] active:text-[var(--primary)]"
                                >
                                    {navLabel(child)}
                                    {child.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.75rem] text-black/[0.2] dark:text-white/[0.2]"></Icon>}
                                </a>;
                            })}
                        </div>
                    </div>;
                }
                return <a aria-label={navLabel(item)} href={item.external ? item.url : url(item.url)} target={item.external ? "_blank" : null}
                          class="btn-plain scale-animation rounded-lg h-11 font-bold px-3 lg:px-4 xl:px-5 active:scale-95"
                >
                    <div class="flex items-center">
                        {navLabel(item)}
                        {item.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.875rem] transition -translate-y-[1px] ml-1 text-black/[0.2] dark:text-white/[0.2]"></Icon>}
                    </div>
                </a>;
            })}
        </div>
        <div class="flex">
            <!--<SearchPanel client:load>-->
            <Search client:only="svelte"></Search>
            {!siteConfig.themeColor.fixed && (
                    <button aria-label="Display Settings" class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="display-settings-switch">
                        <Icon name="material-symbols:palette-outline" class="text-[1.25rem]"></Icon>
                    </button>
            )}
            <LightDarkSwitch client:only="svelte"></LightDarkSwitch>
            <button aria-label="Menu" name="Nav Menu" class="btn-plain scale-animation rounded-lg w-11 h-11 active:scale-90 md:!hidden" id="nav-menu-switch">
                <Icon name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
            </button>
        </div>
        <NavMenuPanel links={links}></NavMenuPanel>
        <DisplaySettings client:only="svelte"></DisplaySettings>
    </div>
</div>

<script>
function switchTheme() {
    if (localStorage.theme === 'dark') {
        document.documentElement.classList.remove('dark');
        localStorage.theme = 'light';
    } else {
        document.documentElement.classList.add('dark');
        localStorage.theme = 'dark';
    }
}

function loadButtonScript() {
    let switchBtn = document.getElementById("scheme-switch");
    if (switchBtn) {
        switchBtn.onclick = function () {
            switchTheme()
        };
    }

    let settingBtn = document.getElementById("display-settings-switch");
    if (settingBtn) {
        settingBtn.onclick = function () {
            let settingPanel = document.getElementById("display-setting");
            if (settingPanel) {
                settingPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function () {
            let menuPanel = document.getElementById("nav-menu-panel");
            if (menuPanel) {
                menuPanel.classList.toggle("float-panel-closed");
            }
        };
    }
}

/*
 * Desktop nav groups (the "更多" dropdown).
 *
 * Reuses the site's only collapse mechanism: the `float-panel-closed` class on a
 * `.float-panel`. No new CSS. Behaviour mirrors the original site: open on mouseenter
 * after 150ms, close on mouseleave after 250ms, click toggles, a document click closes,
 * Escape closes and returns focus to the trigger, `aria-expanded` tracks the state.
 *
 * Handlers are assigned as properties (`onclick`/`onmouseenter`) rather than with
 * addEventListener so that re-running this module — swup replaces <head> with
 * `updateHead: true` — overwrites instead of stacking. Document-level listeners are
 * bound once behind a marker on <html>.
 */
const NAV_GROUP_OPEN_DELAY = 150;
const NAV_GROUP_CLOSE_DELAY = 250;

function setupNavGroups() {
    const groups = document.querySelectorAll<HTMLElement>("[data-nav-group]");

    groups.forEach((group) => {
        const trigger = group.querySelector<HTMLButtonElement>("[data-nav-group-trigger]");
        const panel = group.querySelector<HTMLElement>("[data-nav-group-panel]");
        if (!trigger || !panel) {
            return;
        }

        let openTimer = 0;
        let closeTimer = 0;

        const isOpen = () => !panel.classList.contains("float-panel-closed");

        const open = () => {
            window.clearTimeout(closeTimer);
            panel.classList.remove("float-panel-closed");
            panel.inert = false;
            trigger.setAttribute("aria-expanded", "true");
        };

        const close = () => {
            window.clearTimeout(openTimer);
            window.clearTimeout(closeTimer);
            panel.classList.add("float-panel-closed");
            panel.inert = true;
            trigger.setAttribute("aria-expanded", "false");
        };

        // Start closed and unfocusable; the class is already in the markup, this only
        // keeps the panel's links out of the tab order while it is collapsed.
        if ("inert" in panel) {
            panel.inert = true;
        }

        group.onmouseenter = () => {
            window.clearTimeout(closeTimer);
            if (isOpen()) {
                return;
            }
            window.clearTimeout(openTimer);
            openTimer = window.setTimeout(open, NAV_GROUP_OPEN_DELAY);
        };

        group.onmouseleave = () => {
            window.clearTimeout(openTimer);
            if (!isOpen()) {
                return;
            }
            window.clearTimeout(closeTimer);
            closeTimer = window.setTimeout(close, NAV_GROUP_CLOSE_DELAY);
        };

        trigger.onclick = (event) => {
            // Keep the document click handler below from immediately re-closing it.
            event.stopPropagation();
            window.clearTimeout(openTimer);
            window.clearTimeout(closeTimer);
            if (isOpen()) {
                close();
            } else {
                // Only one group is ever open.
                document.querySelectorAll<HTMLElement>("[data-nav-group]").forEach((other) => {
                    if (other === group) {
                        return;
                    }
                    other.querySelector<HTMLElement>("[data-nav-group-panel]")?.classList.add("float-panel-closed");
                    other.querySelector<HTMLButtonElement>("[data-nav-group-trigger]")?.setAttribute("aria-expanded", "false");
                });
                open();
            }
        };
    });

    if (document.documentElement.dataset.navGroupsBound === "true") {
        return;
    }
    document.documentElement.dataset.navGroupsBound = "true";

    const closeAll = () => {
        document.querySelectorAll<HTMLElement>("[data-nav-group]").forEach((group) => {
            const trigger = group.querySelector<HTMLButtonElement>("[data-nav-group-trigger]");
            const panel = group.querySelector<HTMLElement>("[data-nav-group-panel]");
            if (!trigger || !panel || panel.classList.contains("float-panel-closed")) {
                return;
            }
            panel.classList.add("float-panel-closed");
            panel.inert = true;
            trigger.setAttribute("aria-expanded", "false");
        });
    };

    document.addEventListener("click", closeAll);

    document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") {
            return;
        }
        // Escape closes the open group and hands focus back to its trigger.
        const openGroup = document.querySelector<HTMLElement>("[data-nav-group] [data-nav-group-panel]:not(.float-panel-closed)")?.closest<HTMLElement>("[data-nav-group]");
        if (!openGroup) {
            return;
        }
        closeAll();
        openGroup.querySelector<HTMLButtonElement>("[data-nav-group-trigger]")?.focus();
    });
}

loadButtonScript();
setupNavGroups();
</script>

{import.meta.env.PROD && <script is:inline define:vars={{scriptUrl: url('/pagefind/pagefind.js')}}>
async function loadPagefind() {
    try {
        const response = await fetch(scriptUrl, { method: 'HEAD' });
        if (!response.ok) {
            throw new Error(`Pagefind script not found: ${response.status}`);
        }

        const pagefind = await import(scriptUrl);

        await pagefind.options({
            excerptLength: 20
        });

        window.pagefind = pagefind;

        document.dispatchEvent(new CustomEvent('pagefindready'));
        console.log('Pagefind loaded and initialized successfully, event dispatched.');
    } catch (error) {
        console.error('Failed to load Pagefind:', error);
        window.pagefind = {
            search: () => Promise.resolve({ results: [] }),
            options: () => Promise.resolve(),
        };
        document.dispatchEvent(new CustomEvent('pagefindloaderror'));
        console.log('Pagefind load error, event dispatched.');
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadPagefind);
} else {
    loadPagefind();
}
</script>}
