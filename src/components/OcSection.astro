---
/**
 * OC 设定的紧凑列表。与 NotesSection 的唯一区别只是集合（oc 而非 notes）
 * 和 URL 助手（getSettingsUrlBySlug 而非 getNoteUrlBySlug）：之所以单开一节，
 * 是因为设定作品不属于文章归档，也不该被 ArchivePanel 的标签/分类过滤器误伤。
 * 样式只用站点现有 utility class，不新增样式表。
 */
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import type { OcForList } from "@utils/content-utils";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { getSettingsUrlBySlug, url } from "@utils/url-utils";

interface Props {
	ocs: OcForList[];
	/** 最多渲染这么多行（首页只显示最新几条）。 */
	limit?: number;
	/** 没有设定时整块不渲染（首页）。 */
	hideWhenEmpty?: boolean;
	class?: string;
}

const { ocs, limit, hideWhenEmpty } = Astro.props;
const className = Astro.props.class;

const shown = typeof limit === "number" ? ocs.slice(0, limit) : ocs;
const shouldRender = shown.length > 0 || !hideWhenEmpty;
---

{shouldRender && (
    <div class:list={["card-base px-8 py-6", className]}>
        <div class="flex flex-row w-full items-center justify-between h-[3.75rem]">
            <div class="text-2xl font-bold text-75">{i18n(I18nKey.oc)}</div>
            <a href={url("/settings/")}
               class="transition link text-[var(--primary)] font-medium text-sm">
                {i18n(I18nKey.all)}
            </a>
        </div>

        {shown.length === 0 && (
            <div class="text-50 text-sm py-4">{i18n(I18nKey.noOc)}</div>
        )}

        {shown.map((oc) => (
            <a
                href={getSettingsUrlBySlug(oc.slug)}
                aria-label={oc.data.title}
                class="group btn-plain !block h-10 w-full rounded-lg hover:text-[initial]"
            >
                <div class="flex flex-row justify-start items-center h-full">
                    <!-- date -->
                    <div class="w-[15%] md:w-[10%] transition text-sm text-right text-50">
                        {formatDateToYYYYMMDD(oc.data.published)}
                    </div>

                    <!-- dot and line -->
                    <div class="w-[15%] md:w-[10%] relative dash-line h-full flex items-center">
                        <div
                            class="transition-all mx-auto w-1 h-1 rounded group-hover:h-5
                                   bg-[oklch(0.5_0.05_var(--hue))] group-hover:bg-[var(--primary)]
                                   outline outline-4 z-50
                                   outline-[var(--card-bg)]
                                   group-hover:outline-[var(--btn-plain-bg-hover)]
                                   group-active:outline-[var(--btn-plain-bg-active)]"
                        ></div>
                    </div>

                    <!-- oc title -->
                    <div
                        class="w-[70%] md:max-w-[65%] md:w-[65%] text-left font-bold
                               group-hover:translate-x-1 transition-all group-hover:text-[var(--primary)]
                               text-75 pr-8 whitespace-nowrap overflow-ellipsis overflow-hidden"
                    >
                        {oc.data.title}
                    </div>

                    <!-- tag list -->
                    <div
                        class="hidden md:block md:w-[15%] text-left text-sm transition
                               whitespace-nowrap overflow-ellipsis overflow-hidden text-30"
                    >
                        {(oc.data.tags || []).map((t) => `#${t}`).join(" ")}
                    </div>
                </div>
            </a>
        ))}
    </div>
)}