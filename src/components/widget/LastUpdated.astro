---
import { Icon } from "astro-icon/components";
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";

/*
 * 站点最近一次更新时间。
 *
 * 全站是静态预渲染，所以这里 new Date() 在**构建时**求值 —— 它反映的是「本次构建
 * （部署）的时间」，不是访客打开页面的时间。浏览器端不重新计算，swup 换页复用的也是
 * 构建好的 HTML，因此永远与部署时刻一致。
 *
 * 固定按北京时间格式化：构建机可能在别的时区，不固定的话同一份代码在不同 CI 上会输出
 * 不同字符串，访客看到的日期也会随自己系统时区漂移。
 */
const TIME_ZONE = "Asia/Shanghai";
const UTC_OFFSET = "+08:00"; // 北京时间无夏令时，可安全写死

const buildTime = new Date();

function part(parts: Intl.DateTimeFormatPart[], type: string): string {
	return parts.find((p) => p.type === type)?.value ?? "";
}

const parts = new Intl.DateTimeFormat("en-GB", {
	timeZone: TIME_ZONE,
	year: "numeric",
	month: "2-digit",
	day: "2-digit",
	hour: "2-digit",
	minute: "2-digit",
	hour12: false,
}).formatToParts(buildTime);

const day = `${part(parts, "year")}-${part(parts, "month")}-${part(parts, "day")}`;
const clock = `${part(parts, "hour")}:${part(parts, "minute")}`;
const label = `${day} ${clock}`;
const datetime = `${day}T${clock}:00${UTC_OFFSET}`;
---

<div class="card-base px-4 py-3 flex items-center gap-2 onload-animation" style="animation-delay: 100ms">
    <Icon name="material-symbols:update" class="text-[1.15rem] shrink-0 text-[var(--primary)]"></Icon>
    <span class="text-sm opacity-70">{i18n(I18nKey.lastUpdated)}</span>
    <time class="ml-auto font-mono text-xs opacity-70" datetime={datetime}>{label}</time>
</div>
