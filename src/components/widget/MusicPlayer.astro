		overflow: hidden;
		text-overflow: ellipsis;
	}
	.progress-wrapper {
		margin-bottom: 0.45rem;
	}
	.progress-bar {
		height: 4px;
		border-radius: 2px;
		background: var(--btn-regular-bg);
		cursor: pointer;
		overflow: hidden;
	}
	.progress-fill {
		height: 100%;
		width: 0%;
		background: var(--primary);
		transition: width 0.1s linear;
	}
	.time-display {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: 0.68rem;
		opacity: 0.75;
		margin-top: 0.25rem;
	}
	.loop-btn {
		border: none;
		background: none;
		color: inherit;
		font-size: 0.68rem;
		cursor: pointer;
		padding: 0 0.3rem;
		border-radius: 0.3rem;
		transition: background 0.2s;
	}
	.loop-btn:hover {
		background: var(--btn-regular-bg);
	}
	.volume-wrapper {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}
	.volume-icon {
		width: 15px;
		height: 15px;
		opacity: 0.7;
		flex-shrink: 0;
	}
	.volume-slider {
		flex: 1;
		height: 3px;
		accent-color: var(--primary);
		cursor: pointer;
	}
	.music-status {
		font-size: 0.68rem;
		opacity: 0.7;
		text-align: center;
		min-height: 0.9rem;
