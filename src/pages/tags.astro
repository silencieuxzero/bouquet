---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import ButtonTag from "../components/control/ButtonTag.astro";
import { getSortedPostsList, getTagList } from "../utils/content-utils";
import { getTagUrl, url } from "../utils/url-utils";

const tags = await getTagList();
const postsCount = (await getSortedPostsList()).length;
const subtitle = `${tags.length} ${i18n(I18nKey.tags)} · ${postsCount} ${i18n(I18nKey.postsCount)}`;
---

<MainGridLayout title={i18n(I18nKey.tags)} description={subtitle}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div class="card-base z-10 px-6 md:px-9 py-6 relative w-full">
            <div class="flex items-center gap-3 mb-1">
                <Icon
                    name="material-symbols:tag-rounded"
                    class="text-[var(--primary)] text-[1.75rem] shrink-0"
                />
                <div class="font-bold text-3xl text-90">
                    {i18n(I18nKey.tags)}
                </div>
            </div>
            <div class="text-50 text-sm mb-6">{subtitle}</div>
            <a
                href={url("/")}
                class="link-lg inline-flex items-center gap-1 text-sm text-75 hover:text-[var(--primary)] mb-6"
            >
                <Icon name="material-symbols:arrow-back-rounded" class="text-[1.125rem]" />
                {i18n(I18nKey.backToHome)}
            </a>
            {
                tags.length === 0 ? (
                    <div class="text-50 text-center py-8">
                        {i18n(I18nKey.noResults)}
                    </div>
                ) : (
                    <div class="flex gap-2 flex-wrap">
                        {tags.map((t) => (
                            <ButtonTag
                                href={getTagUrl(t.name)}
                                label={`View all posts with the ${t.name.trim()} tag`}
                            >
                                <Icon
                                    name="material-symbols:tag-rounded"
                                    class="mr-1 text-[0.875rem] text-[var(--primary)]"
                                />
                                {t.name.trim()}
                                <span class="text-50 text-xs ml-1">
                                    ({t.count})
                                </span>
                            </ButtonTag>
                        ))}
                    </div>
                )
            }
        </div>
    </div>
</MainGridLayout>
