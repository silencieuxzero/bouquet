---
// ============================================================================
// 画廊
// ============================================================================
// 网格展示图片，点击可看大图（灯箱），带版权信息弹窗。
// 图片列表来自 src/data/gallery.json（经 src/config.ts 的 galleryConfig 导出）。
// ============================================================================
import MainGridLayout from "@layouts/MainGridLayout.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { url } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import { galleryConfig, subGalleryConfig } from "../../config";

const images = galleryConfig.images;

/** 本地图片走 BASE_URL，外链保持原样 */
function resolveSrc(src: string): string {
	return src.startsWith("/") ? url(src) : src;
}
---

<MainGridLayout title={galleryConfig.title} description={galleryConfig.subtitle || galleryConfig.title}>
    <div class="card-base px-6 md:px-9 py-6 w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div class="font-bold text-3xl text-black/90 dark:text-white/90 mb-2">{galleryConfig.title}</div>
        {galleryConfig.subtitle && (
            <p class="text-sm text-black/50 dark:text-white/50 mb-6">{galleryConfig.subtitle}</p>
        )}

        <div class="gallery-grid">
            {images.map((image, i) => (
                <figure
                    class="gallery-item onload-animation"
                    style={`animation-delay: calc(var(--content-delay) + ${i * 40}ms);`}
                >
                    <div class="gallery-img-wrap">
                        <img
                            src={resolveSrc(image.src)}
                            alt={image.alt}
                            loading="lazy"
                            data-lightbox
                            data-copyright={image.copyright ?? ""}
                            data-source={image.source ?? ""}
                        />
                        {(image.copyright || image.source) && (
                            <button class="copyright-btn" aria-label={i18n(I18nKey.viewCopyrightInfo)} title={i18n(I18nKey.copyrightInfo)}>©</button>
                        )}
                    </div>
                    <figcaption class="gallery-item-caption">{image.alt}</figcaption>
                </figure>
            ))}
        </div>

        <a href={url("/gallery/sub-gallery/")} class="sub-gallery-card group">
            <div class="min-w-0">
                <div class="font-bold text-lg text-black/90 dark:text-white/90 transition group-hover:text-[var(--primary)]">
                    {subGalleryConfig.title}
                </div>
                {subGalleryConfig.subtitle && (
                    <div class="text-sm text-black/50 dark:text-white/50">{subGalleryConfig.subtitle}</div>
                )}
            </div>
            <Icon name="material-symbols:chevron-right-rounded" class="transition text-[var(--primary)] text-[2rem] shrink-0" />
        </a>
    </div>

    <!-- 灯箱 -->
    <div class="lightbox-overlay" id="lightbox" role="dialog" aria-modal="true" aria-label={i18n(I18nKey.imagePreview)}>
        <button class="lightbox-close" aria-label={i18n(I18nKey.close)}>&times;</button>
        <div class="lightbox-content">
            <img src="" alt={i18n(I18nKey.previewImage)} />
        </div>
    </div>

    <!-- 版权信息弹窗 -->
    <div class="copyright-modal-overlay" id="copyrightModal" role="dialog" aria-modal="true" aria-label={i18n(I18nKey.copyrightInfo)}>
        <div class="copyright-modal card-base">
            <button class="copyright-modal-close" aria-label={i18n(I18nKey.close)}>&times;</button>
            <h3 class="font-bold mb-3">{i18n(I18nKey.copyrightInfo)}</h3>
            <p class="text-sm mb-1"><strong>{i18n(I18nKey.imageSource)}</strong><span id="copyrightSource"></span></p>
            <p class="text-sm"><strong>{i18n(I18nKey.imageOwner)}</strong><span id="copyrightOwner"></span></p>
        </div>
    </div>
</MainGridLayout>

<script>
	function initGallery() {
		const lightbox = document.getElementById("lightbox");
		if (!lightbox || lightbox.dataset.ready === "1") return;
		lightbox.dataset.ready = "1";

		const lightboxImg = lightbox.querySelector<HTMLImageElement>(".lightbox-content img");
		const closeBtn = lightbox.querySelector<HTMLElement>(".lightbox-close");
		const modal = document.getElementById("copyrightModal");
		const modalSource = document.getElementById("copyrightSource");
		const modalOwner = document.getElementById("copyrightOwner");
		const modalClose = modal?.querySelector<HTMLElement>(".copyright-modal-close");

		function openLightbox(src: string, alt: string) {
			if (!lightboxImg) return;
			lightboxImg.src = src;
			lightboxImg.alt = alt;
			lightbox?.classList.add("active");
			document.body.style.overflow = "hidden";
		}
		function closeLightbox() {
			lightbox?.classList.remove("active");
			document.body.style.overflow = "";
		}

		closeBtn?.addEventListener("click", closeLightbox);
		lightbox.addEventListener("click", (e) => {
			if (e.target === lightbox) closeLightbox();
		});
		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape") {
				closeLightbox();
				modal?.classList.remove("active");
			}
		});

		// 版权弹窗
		function openCopyright(source: string, owner: string) {
			if (!modal || !modalSource || !modalOwner) return;
			modalSource.textContent = source || "—";
			modalOwner.textContent = owner || "—";
			modal.classList.add("active");
		}
		modalClose?.addEventListener("click", () => modal?.classList.remove("active"));
		modal?.addEventListener("click", (e) => {
			if (e.target === modal) modal.classList.remove("active");
		});

		document.querySelectorAll<HTMLElement>(".gallery-item").forEach((item) => {
			const img = item.querySelector<HTMLImageElement>("img[data-lightbox]");
			const btn = item.querySelector<HTMLElement>(".copyright-btn");
			if (img) {
				img.addEventListener("click", () => openLightbox(img.src, img.alt));
			}
			if (btn) {
				btn.addEventListener("click", (e) => {
					e.stopPropagation();
					openCopyright(
						img?.dataset.source ?? "",
						img?.dataset.copyright ?? "",
					);
				});
			}
		});
	}

	initGallery();
	const w = window as any;
	if (w?.swup?.hooks) {
		w.swup.hooks.on("page:view", initGallery);
	} else {
		document.addEventListener("swup:enable", () => w.swup.hooks.on("page:view", initGallery));
	}
</script>

<style>
	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 1rem;
	}
	.gallery-item {
		margin: 0;
		border-radius: var(--radius-large, 0.75rem);
		overflow: hidden;
		background: var(--btn-regular-bg);
		display: flex;
		flex-direction: column;
		transition: transform 0.2s ease;
	}
	.gallery-item:hover {
		transform: scale(1.02);
	}
	.gallery-img-wrap {
		position: relative;
		overflow: hidden;
	}
	.gallery-img-wrap img {
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		display: block;
		cursor: zoom-in;
	}
	.copyright-btn {
		position: absolute;
		top: 0.5rem;
		right: 0.5rem;
		width: 30px;
		height: 30px;
		border: none;
		border-radius: 50%;
		background: rgba(0, 0, 0, 0.55);
		color: #fff;
		font-size: 0.8rem;
		font-weight: bold;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		transition: opacity 0.2s ease, transform 0.2s ease;
		z-index: 2;
		line-height: 1;
	}
	.gallery-img-wrap:hover .copyright-btn {
		opacity: 1;
	}
	.copyright-btn:hover {
		transform: scale(1.1);
		background: rgba(0, 0, 0, 0.8);
	}
	.gallery-item-caption {
		padding: 0.5rem 0.7rem;
		font-size: 0.8rem;
		text-align: center;
		color: var(--btn-content);
	}
	.sub-gallery-card {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 1.75rem;
		padding: 1.1rem 1.4rem;
		border-radius: var(--radius-large, 0.75rem);
		background: var(--btn-regular-bg);
		text-decoration: none;
		transition: background 0.25s ease;
	}
	.sub-gallery-card:hover {
		background: var(--btn-regular-bg-hover);
	}

	/* 灯箱 */
	.lightbox-overlay {
		position: fixed;
		inset: 0;
		z-index: 200;
		background: rgba(0, 0, 0, 0.88);
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.25s ease;
	}
	.lightbox-overlay.active {
		opacity: 1;
		pointer-events: auto;
	}
	.lightbox-content {
		max-width: 92vw;
		max-height: 88vh;
	}
	.lightbox-content img {
		max-width: 92vw;
		max-height: 88vh;
		object-fit: contain;
		display: block;
		border-radius: 0.5rem;
	}
	.lightbox-close {
		position: absolute;
		top: 1.25rem;
		right: 1.5rem;
		width: 40px;
		height: 40px;
		border: none;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.15);
		color: #fff;
		font-size: 1.6rem;
		line-height: 1;
		cursor: pointer;
		transition: background 0.2s;
	}
	.lightbox-close:hover {
		background: rgba(255, 255, 255, 0.3);
	}

	/* 版权弹窗 */
	.copyright-modal-overlay {
		position: fixed;
		inset: 0;
		z-index: 210;
		background: rgba(0, 0, 0, 0.5);
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.25s ease;
	}
	.copyright-modal-overlay.active {
		opacity: 1;
		pointer-events: auto;
	}
	.copyright-modal {
		position: relative;
		min-width: 280px;
		max-width: 90vw;
		padding: 1.4rem 1.6rem;
		border-radius: var(--radius-large, 0.75rem);
	}
	.copyright-modal-close {
		position: absolute;
		top: 0.5rem;
		right: 0.6rem;
		border: none;
		background: none;
		font-size: 1.3rem;
		line-height: 1;
		cursor: pointer;
		color: var(--btn-content);
	}
</style>
