---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import { getCategoryList } from "../utils/content-utils";
import { url } from "../utils/url-utils";

const categories = await getCategoryList();
const postsCount = categories.reduce((sum, c) => sum + c.count, 0);
const subtitle = `${categories.length} ${i18n(I18nKey.categories)} · ${postsCount} ${i18n(I18nKey.postsCount)}`;
---

<MainGridLayout title={i18n(I18nKey.categories)} description={subtitle}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div class="card-base z-10 px-6 md:px-9 py-6 relative w-full">
            <div class="flex items-center gap-3 mb-1">
                <Icon
                    name="material-symbols:folder-outline-rounded"
                    class="text-[var(--primary)] text-[1.75rem] shrink-0"
                />
                <div class="font-bold text-3xl text-90">
                    {i18n(I18nKey.categories)}
                </div>
            </div>
            <div class="text-50 text-sm mb-6">{subtitle}</div>
            <a
                href={url("/")}
                class="link-lg inline-flex items-center gap-1 text-sm text-75 hover:text-[var(--primary)] mb-6"
            >
                <Icon name="material-symbols:arrow-back-rounded" class="text-[1.125rem]" />
                {i18n(I18nKey.backToHome)}
            </a>
            {
                categories.length === 0 ? (
                    <div class="text-50 text-center py-8">
                        {i18n(I18nKey.noResults)}
                    </div>
                ) : (
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        {categories.map((c, i) => (
                            <a
                                href={c.url}
                                aria-label={`View all posts in the ${c.name.trim()} category`}
                                class="card-base group flex items-center justify-between gap-3 px-4 h-16 w-full rounded-[var(--radius-large)] overflow-hidden relative onload-animation hover:bg-[var(--btn-card-bg-hover)] active:bg-[var(--btn-card-bg-active)] active:scale-95"
                                style={`animation-delay: calc(var(--content-delay) + ${i * 50}ms);`}
                            >
                                <div class="flex items-center gap-3 min-w-0">
                                    <Icon
                                        name="material-symbols:folder-outline-rounded"
                                        class="text-[var(--primary)] text-[1.375rem] shrink-0"
                                    />
                                    <span class="font-bold text-lg text-90 truncate transition group-hover:text-[var(--primary)]">
                                        {c.name.trim()}
                                    </span>
                                </div>
                                <div class="transition px-2 h-7 ml-4 min-w-[2rem] rounded-lg text-sm font-bold text-[var(--btn-content)] dark:text-[var(--deep-text)] bg-[var(--btn-regular-bg)] dark:bg-[var(--primary)] flex items-center justify-center shrink-0">
                                    {c.count}
                                </div>
                            </a>
                        ))}
                    </div>
                )
            }
        </div>
    </div>
</MainGridLayout>
