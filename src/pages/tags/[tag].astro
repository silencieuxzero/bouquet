---
import type { CollectionEntry } from "astro:content";
import PostCard from "@components/PostCard.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts, getTagList } from "@utils/content-utils";
import { getPostUrlBySlug, url } from "@utils/url-utils";
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";

export const getStaticPaths = (async () => {
	const [tags, posts] = await Promise.all([getTagList(), getSortedPosts()]);

	return tags.map((tag) => ({
		// The name is emitted exactly as stored: no lowercasing, no manual
		// percent-encoding. Astro encodes the segment when it writes the route,
		// so "CSS" stays /tags/CSS/ and never becomes /tags/css/.
		params: { tag: tag.name },
		props: {
			name: tag.name,
			count: tag.count,
			posts: posts.filter((entry) => entry.data.tags.includes(tag.name)),
		},
	}));
}) satisfies GetStaticPaths;

interface Props {
	name: string;
	count: number;
	posts: CollectionEntry<"posts">[];
}

const { name, count, posts } = Astro.props;
const title = `${i18n(I18nKey.tags)} · ${name}`;
const subtitle = `${count} ${i18n(I18nKey.postsCount)}`;

let delay = 0;
const interval = 50;
---

<MainGridLayout title={title} description={subtitle}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div class="card-base z-10 px-6 md:px-9 py-6 relative w-full">
            <div class="flex items-center gap-3 mb-1">
                <Icon
                    name="material-symbols:tag-rounded"
                    class="text-[var(--primary)] text-[1.75rem] shrink-0"
                />
                <div class="font-bold text-3xl text-90">{title}</div>
            </div>
            <div class="text-50 text-sm mb-6">{subtitle}</div>
            <a
                href={url("/tags/")}
                class="link-lg inline-flex items-center gap-1 text-sm text-75 hover:text-[var(--primary)] mb-6"
            >
                <Icon name="material-symbols:arrow-back-rounded" class="text-[1.125rem]" />
                {i18n(I18nKey.tags)}
            </a>
            {
                posts.length === 0 ? (
                    <div class="text-50 text-center py-8">
                        {i18n(I18nKey.noResults)}
                    </div>
                ) : (
                    <div class="transition flex flex-col rounded-[var(--radius-large)] bg-[var(--card-bg)] py-1 md:py-0 md:bg-transparent md:gap-4">
                        {posts.map((entry) => (
                            <PostCard
                                entry={entry}
                                title={entry.data.title}
                                tags={entry.data.tags}
                                category={entry.data.category}
                                published={entry.data.published}
                                updated={entry.data.updated}
                                url={getPostUrlBySlug(entry.id)}
                                image={entry.data.image}
                                description={entry.data.description}
                                draft={entry.data.draft}
                                encrypted={entry.data.encrypted}
                                class="onload-animation"
                                style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval}ms);`}
                            />
                        ))}
                    </div>
                )
            }
        </div>
    </div>
</MainGridLayout>
