---
import ImageWrapper from "@components/misc/ImageWrapper.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedEssayList } from "@utils/content-utils";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { getEssayUrlBySlug, getPostAssetBasePath } from "@utils/url-utils";
import { Icon } from "astro-icon/components";

const essays = await getSortedEssayList();
---

<MainGridLayout title={i18n(I18nKey.essay)} description={i18n(I18nKey.essay)}>
    <div class="transition flex flex-col rounded-[var(--radius-large)] bg-[var(--card-bg)] py-1 md:py-0 md:bg-transparent md:gap-4 mb-4">
        {essays.length === 0 && (
            <div class="card-base px-6 py-8 text-center text-black/50 dark:text-white/50">
                {i18n(I18nKey.noEssays)}
            </div>
        )}
        {essays.map((essay, i) => {
            const hasCover = typeof essay.data.image === "string" && essay.data.image !== "";
            return (
            <a
                href={getEssayUrlBySlug(essay.slug)}
                class="card-base group px-6 py-5 md:px-9 md:py-6 w-full rounded-[var(--radius-large)] overflow-hidden relative onload-animation"
                style={`animation-delay: calc(var(--content-delay) + ${i * 50}ms);`}
            >
                <div class="flex items-start justify-between gap-4">
                    <div class="min-w-0 flex-1">
                        <div class="font-bold text-xl text-90 transition group-hover:text-[var(--primary)] mb-2">
                            {essay.data.encrypted && (
                                <span class="inline-flex items-center align-middle mr-2 px-2 py-0.5 rounded-md text-sm font-medium whitespace-nowrap bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">{i18n(I18nKey.encrypted)}</span>
                            )}
                            {essay.data.title}
                        </div>
                        {essay.data.description && (
                            <div class="text-75 text-sm mb-2 line-clamp-2">{essay.data.description}</div>
                        )}
                        <div class="flex flex-wrap items-center gap-3 text-sm text-black/30 dark:text-white/30">
                            <span>{formatDateToYYYYMMDD(essay.data.published)}</span>
                            {essay.data.category && <span>| {essay.data.category}</span>}
                        </div>
                    </div>
                    {hasCover && (
                        <div class="shrink-0 w-24 h-16 md:w-32 md:h-20 rounded-xl overflow-hidden">
                            <ImageWrapper
                                src={essay.data.image}
                                basePath={getPostAssetBasePath(essay.filePath)}
                                alt={essay.data.title}
                                class="w-full h-full"
                            />
                        </div>
                    )}
                    <Icon
                        name="material-symbols:chevron-right-rounded"
                        class="transition text-[var(--primary)] text-[2rem] shrink-0 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0"
                    />
                </div>
            </a>
            );
        })}
    </div>
</MainGridLayout>
