---
import type { GetStaticPaths } from "astro";
import Pagination from "../components/control/Pagination.astro";
import NotesSection from "../components/NotesSection.astro";
import PostPage from "../components/PostPage.astro";
import { PAGE_SIZE } from "../constants/constants";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedNotesList, getSortedPosts } from "../utils/content-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	return paginate(allBlogPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page } = Astro.props;

const len = page.data.length;

// Notes are deliberately kept OUT of the paginated post stream. Posts and notes
// are separate collections with disjoint tag spaces, and merging them would
// change what PAGE_SIZE means (a page would hold a variable mix of two kinds of
// content). Instead the first page surfaces the latest notes in a clearly
// labelled section; deeper pages stay posts-only.
const HOME_NOTES_LIMIT = 5;
const notes = page.currentPage === 1 ? await getSortedNotesList() : [];
---

<MainGridLayout>
    <PostPage page={page}></PostPage>
    <Pagination class="mx-auto onload-animation" page={page} style={`animation-delay: calc(var(--content-delay) + ${(len)*50}ms)`}></Pagination>
    {page.currentPage === 1 && (
        <NotesSection notes={notes} limit={HOME_NOTES_LIMIT} hideWhenEmpty class="mt-6 onload-animation"></NotesSection>
    )}
</MainGridLayout>
