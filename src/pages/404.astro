---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { url } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
---

<MainGridLayout
    title={i18n(I18nKey.notFound)}
    description={i18n(I18nKey.pageNotFoundDesc)}
>
    <div class="card-base z-10 px-6 md:px-9 py-10 w-full rounded-[var(--radius-large)] overflow-hidden relative onload-animation">
        <div class="flex flex-col items-center justify-center text-center">
            <Icon
                name="material-symbols:explore-off-rounded"
                class="text-[var(--primary)] text-[3.5rem] mb-4"
            />
            <div class="font-bold text-3xl text-90 mb-3">
                {i18n(I18nKey.notFound)}
            </div>
            <p class="text-75 text-sm md:text-base max-w-[32rem] mb-8">
                {i18n(I18nKey.pageNotFoundDesc)}
            </p>
            <a
                href={url("/")}
                class="btn-regular h-10 px-6 rounded-lg font-bold active:scale-95"
                aria-label={i18n(I18nKey.backToHome)}
            >
                <Icon name="material-symbols:home-outline-rounded" class="mr-2" />
                {i18n(I18nKey.backToHome)}
            </a>
        </div>
    </div>
</MainGridLayout>
